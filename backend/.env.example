# ==========================================
# SecureID IAM — Environment Configuration
# ==========================================

# Environment Mode (development / test / production)
NODE_ENV=development

# Server Port (Vercel sets this automatically)
PORT=3000

# MongoDB Connection URI
# Local:   mongodb://localhost:27017/secureid
# Atlas:   mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/secureid?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/secureid

# OTP Configuration
OTP_EXPIRY_MINUTES=3
OTP_MAX_ATTEMPTS=3

# Frontend Origin for CORS (comma-separated for multiple origins)
# Not needed if frontend and backend are same-origin (e.g., on Vercel)
FRONTEND_URL=http://localhost:5500

# Bcrypt Salt Rounds
BCRYPT_SALT_ROUNDS=12

# JWT Secret Key (REQUIRED in production — use a strong random secret)
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ec3cd7233f0677a11e0616d67b3ffb3c9aec9535f4207008eec3f099f317349192f4df88ec1d7ff3cfd15d0989cf19dc169151bbc6d703f45859697c2ebd08ff
JWT_EXPIRY=15m

# Session Secret (optional — for signed cookies)
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=c714202df7533cf872d8f14dc8597018939bba6b0758c4c8fe6c01cea78153d0e4d2c899d8b4dec5e2aee53a1c61942ba4164a51c895f8a69e796db8ee827b36d

# Cookie SameSite policy (lax / strict / none)
# Use 'lax' for same-domain, 'none' for cross-domain (requires Secure)
COOKIE_SAME_SITE=lax
