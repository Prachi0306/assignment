# Environment Mode (development / test / production)
NODE_ENV=development

# Server Port
PORT=3000

# MongoDB Connection URI (local or cloud)
MONGODB_URI=mongodb://localhost:27017/secureid

# OTP Configuration
OTP_EXPIRY_MINUTES=3
OTP_MAX_ATTEMPTS=3

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:5500

# Bcrypt Salt Rounds
BCRYPT_SALT_ROUNDS=12

# JWT Secret Key (use a strong random secret in production)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY=15m
