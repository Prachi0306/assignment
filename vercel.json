{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      }
    },
    {
      "src": "/css/(.*)",
      "dest": "/frontend/css/$1",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "src": "/js/(.*)",
      "dest": "/frontend/js/$1",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Cache-Control": "public, max-age=3600"
      }
    },
    { "src": "/login\\.html", "dest": "/frontend/login.html" },
    { "src": "/register\\.html", "dest": "/frontend/register.html" },
    { "src": "/dashboard\\.html", "dest": "/frontend/dashboard.html" },
    { "src": "/login", "dest": "/frontend/login.html" },
    { "src": "/register", "dest": "/frontend/register.html" },
    { "src": "/dashboard", "dest": "/frontend/dashboard.html" },
    { "src": "/", "dest": "/frontend/register.html" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}
